# Archivos que no se suben del código fuente (src/).

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales y configuración local
.venv/
venv/
env/
.env
*.local

# Herramientas de desarrollo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Salidas generadas al ejecutar o validar (actas en PDF, libros de Excel de prueba)
*.pdf
*.xlsx

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
